# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
build/
dist/

# === IDE / OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# === Project artefacts (huge or transient) ===
# Backtest reports (multi-GB after full runs)
storage/reports/

# Runtime logs
storage/logs/

# Data caches (parquet bars, news, fundamentals — hundreds of MB)
storage/cache/

# In-run memory state written by pipeline
storage/memory/

# Live-tool session state: per-session memory + decision artifacts
storage/live/

# === Agent tooling state (contains absolute paths / local machine details) ===
.omc/
.claude/
.agents/

# === Secrets ===
.env
.env.*
.envmm
.envds
.envoss
.envnvidia

# === LaTeX build artefacts (embed absolute build paths) ===
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# External vendored repos (kept outside version control per project policy)
external/

# Third-party material: published PDFs and other authors' paper sources.
# Not ours to redistribute, and the author blocks break submission anonymity.
literature/
mentor_work/

# tmp / scratch
tmp/
*.tmp
*.bak
*~

# Notebooks checkpoints
.ipynb_checkpoints/

# --- explicit KEEP overrides ---
!.env.example
# Paper sources must be versioned even though the LaTeX artefact rules above
# would otherwise catch same-named files.
!AAAIAuthorKit27/**/*.tex
!AAAIAuthorKit27/**/*.bib
