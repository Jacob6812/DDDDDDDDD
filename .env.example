# DarwinTrade credentials and runtime switches.
# Copy to `.env` and fill in your own values. Never commit `.env`.

# --- LLM backbone (OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.5-pro
LLM_SEED=1234
LLM_REQUEST_TIMEOUT=120

# --- Market data providers ---
# Needed to build/extend the cache under storage/cache/, and for the live tool
# to price dates that are not cached yet. Backtests restricted to already-cached
# symbols and dates need no keys.
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Live tool (`darwintrade serve` / `darwintrade predict`) ---
# Where bars/news/fundamentals are read and written. Point this at the cache
# shipped for paper reproduction to avoid refetching.
# DARWINTRADE_CACHE_DIR=storage/cache
# Where per-session memory is persisted. Reusing a session is what lets the
# three memory layers keep evolving across runs.
# DARWINTRADE_SESSION_DIR=storage/live/sessions
# `auto` calls the providers above on a cache miss; `offline_only` never leaves
# the cache (demo mode — only cached symbols and dates will resolve).
DARWINTRADE_DATA_MODE=auto
DARWINTRADE_DEFAULT_CAPITAL=100000

# --- Parallelism (tune to your provider's rate limits) ---
DARWINTRADE_SYMBOL_PARALLELISM=4
DARWINTRADE_ROLE_PARALLELISM=4

# --- Research switches (defaults reproduce the reported runs) ---
# Aggregator weights signals by skill * confidence^2.
DARWIN_CONFIDENCE_SQUARED=1
# Strategic rollback compares against equal-weight universe return.
DARWIN_ROLLBACK_REFERENCE=counterfactual_alpha
# Set to 1 to swap the LLM regime classifier for a Gaussian HMM.
DARWIN_REGIME_HMM=0
# Set to 1 to use the deterministic trend rule only (no LLM regime call).
DARWIN_REGIME_RULE_ONLY=0
