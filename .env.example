# DarwinTrade credentials and runtime switches.
# Copy to `.env` and fill in your own values. Never commit `.env`.

# --- LLM backbone (OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.5-pro
LLM_SEED=1234
LLM_REQUEST_TIMEOUT=120

# --- Market data providers ---
# Only needed to build/extend the offline cache under storage/cache/.
# Runs restricted to already-cached symbols and dates need no keys.
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Parallelism (tune to your provider's rate limits) ---
DARWINTRADE_SYMBOL_PARALLELISM=4
DARWINTRADE_ROLE_PARALLELISM=4

# --- Research switches (defaults reproduce the reported runs) ---
# Aggregator weights signals by skill * confidence^2.
DARWIN_CONFIDENCE_SQUARED=1
# Strategic rollback compares against equal-weight universe return.
DARWIN_ROLLBACK_REFERENCE=counterfactual_alpha
# Set to 1 to swap the LLM regime classifier for a Gaussian HMM.
DARWIN_REGIME_HMM=0
# Set to 1 to use the deterministic trend rule only (no LLM regime call).
DARWIN_REGIME_RULE_ONLY=0
